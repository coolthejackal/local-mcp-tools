# MCPTools .env şablonu — kendi .env dosyanı oluştur ve değerleri doldur.
# Bu dosya commit edilebilir; .env edilmemeli (gitignore).

# ─── Zorunlu ──────────────────────────────────────────────────────────────────
# Taranacak proje kök dizini (mutlak yol önerilir).
CTX_ROOT=C:\Projects\MyApp


# ─── Opsiyonel: LLM Enrichment (audit araçları için) ──────────────────────────
# Boş bırakırsan veya LLM_ENABLED=false yaparsan: tüm araçlar tamamen statik analiz
# yapar, hiçbir HTTP çağrısı olmaz, hiçbir ek paket çekilmez (default davranış).

LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_BUDGET_USD_PER_RUN=0.50
LLM_CACHE_DIR=.cache/mcp-llm
